-- Retribution (Herald of the Sun), transcribed from the simc `retribution` list.
--
-- Each glow is one APL line with the terms the addon cannot read dropped, so a lit icon means
-- "this line's readable conditions hold" and never "cast this now": priority ORDER is not
-- expressible. Several of these light at once.
--
-- Hammer of Light and everything gated on `buff.hammer_of_light_ready` is absent on purpose --
-- it comes from Light's Deliverance, which is a TEMPLAR talent and not in this tree.
--
-- Check it, or turn it into a share string:
--     uv run python -m wowkb.smartglo check  projects/smart-glo/rules/retribution-herald.sg
--     uv run python -m wowkb.smartglo encode projects/smart-glo/rules/retribution-herald.sg

spec paladin.retribution

-- The generator the whole list is built around, and Herald's engine: Wake of Ashes is what
-- applies Dawnlight, so its cooldown is the spec's rhythm.
glow "Wake of Ashes"
  on     wake_of_ashes
  when   ready(wake_of_ashes)

glow "Divine Toll"
  on     divine_toll
  when   ready(divine_toll)

glow "Avenging Wrath"
  on     avenging_wrath
  when   ready(avenging_wrath)

-- `cooldown.wake_of_ashes.remains<gcd` -- Execution Sentence goes out just before Wake of
-- Ashes, so both being ready is the readable form of "they are about to line up".
glow "Execution Sentence into Wake of Ashes"
  on     execution_sentence
  when   ready(execution_sentence) and ready(wake_of_ashes)

-- `holy_power=5&cooldown.wake_of_ashes.remains` -- spend at cap, EXCEPT when Wake of Ashes is
-- ready, because that is the one thing worth capping into.
glow "Templar's Verdict at cap"
  on     templars_verdict
  when   holy_power == 5 and not ready(wake_of_ashes)

glow "Divine Storm on Empyrean Power"
  on     divine_storm
  when   aura(empyrean_power)

glow "Blade of Justice on a proc"
  on     blade_of_justice
  when   aura(art_of_war) or aura(righteous_cause)

-- `hammer_of_wrath,if=talent.walk_into_light` sits ABOVE Blade of Justice, so with the talent
-- taken the two swap order. This marks Blade of Justice as the one to hold.
glow "Blade of Justice held under Walk Into Light"
  on     blade_of_justice
  when   talent(walk_into_light) and aura(avenging_wrath)

-- ---------------------------------------------------------------- from the Icy Veins priority
--
-- The APL was the only source when this profile was written; the guide adds rungs it does not
-- carry and names the spender the APL calls by its base name.

-- "Cast Hammer of Wrath with 2 charges" is rung 11, well above the bare Hammer of Wrath at 14
-- and 16 -- so the cap is the sharp case, and a capped charge is a resource actively draining.
glow "Hammer of Wrath at cap"
  on     hammer_of_wrath
  when   at_max_charges(hammer_of_wrath)
  urgent

-- "Cast Blade of Justice with 2 stacks of Art of War" is rung 9; the bare Blade of Justice is
-- rung 15. Two stacks is the cap, so this is the same waste signal in aura form.
glow "Blade of Justice on capped Art of War"
  on     blade_of_justice
  bind   art_of_war.stacks >= 2
  urgent

-- "Cast Divine Storm with a Divine Arbiter proc from Final Verdict and 5 Holy Power" -- rung 5,
-- the highest non-cooldown rung in the list.
glow "Divine Storm on Divine Arbiter at cap"
  on     divine_storm
  when   aura(divine_arbiter) and holy_power >= 5
  urgent

-- Final Verdict is what the guide actually names as the spender -- Templar's Verdict is the
-- base it replaces, so both ship and only the talented one ever lays out a row.
glow "Final Verdict at cap"
  on     final_verdict
  when   holy_power >= 5
  urgent

glow "Judgment with room to spend"
  on     judgment
  when   ready(judgment) and holy_power < 5
