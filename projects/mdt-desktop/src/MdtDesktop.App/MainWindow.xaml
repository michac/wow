<Window x:Class="MdtDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:map="clr-namespace:MdtDesktop.App.Map"
        mc:Ignorable="d"
        Title="MDT Desktop" Height="720" Width="1180"
        Icon="icon.ico"
        Background="#16191C"
        Loaded="OnLoaded"
        Closing="OnWindowClosing">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D6DBE0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- F11 must work in kiosk mode, where the button that toggles it is hidden. -->
    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleKioskCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- The toolbar hides in kiosk mode, so the map is the only thing on the monitor. -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="#1E2226" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dungeon" />
                <ComboBox x:Name="DungeonPicker" Width="220"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnDungeonChanged" />

                <TextBlock x:Name="SubLevelLabel" Text="Sublevel" Margin="16,0,0,0"
                           Visibility="Collapsed" />
                <ComboBox x:Name="SubLevelPicker" Width="70" Visibility="Collapsed"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnSubLevelChanged" />

                <TextBlock Text="Route" Margin="16,0,0,0" />
                <ComboBox x:Name="RoutePicker" Width="260"
                          DisplayMemberPath="Label"
                          SelectionChanged="OnRouteChanged" />
                <Button Content="Forget" Click="OnForgetRouteClicked" />

                <Button Content="Fit" Margin="16,0,0,0" Click="OnFitClicked" />
                <CheckBox x:Name="TopmostToggle" Content="On top" Foreground="#D6DBE0"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="OnTopmostChanged" Unchecked="OnTopmostChanged" />
                <Button Content="Kiosk (F11)" Click="OnKioskClicked" />
                <Button x:Name="UpdateButton" Content="Update MDT data" Click="OnUpdateClicked" />
            </StackPanel>
        </Border>

        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="#1E2226" Padding="10,6">
            <TextBlock x:Name="Status" Text="Starting…" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- The route panel. It collapses in kiosk mode too: on a second monitor mid-dungeon
             the map and the forces readout are the whole point, not the controls. -->
        <Border x:Name="RoutePanel" DockPanel.Dock="Right" Width="290"
                Background="#1A1D21" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Paste an MDT route string" FontWeight="SemiBold" />
                    <TextBox x:Name="PasteBox" Margin="0,6,0,0" Height="58"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#0F1214" Foreground="#D6DBE0"
                             BorderBrush="#33383D" />
                    <Button Content="Import" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Click="OnImportClicked" />

                    <TextBlock x:Name="RouteHeader" Margin="0,14,0,0" FontWeight="SemiBold"
                               Text="No route loaded" TextWrapping="Wrap" />
                    <TextBlock x:Name="ForcesReadout" Margin="0,4,0,0" FontSize="20"
                               FontWeight="Bold" Foreground="#F2F5F8" Text="—" />
                    <TextBlock x:Name="RouteState" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="#9AA3AC" Text="" />
                    <TextBlock x:Name="RouteWarnings" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="#E0A44A" Text="" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                        <Button Content="◀ Prev" Margin="0" Click="OnPreviousPullClicked" />
                        <Button Content="Next ▶" Click="OnNextPullClicked" />
                        <TextBlock x:Name="HotKeyHint" Margin="10,0,0,0" Foreground="#9AA3AC"
                                   FontSize="11" Text="" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="PullList" Background="Transparent" BorderBrush="#33383D"
                         Foreground="#D6DBE0"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="OnPullSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="8" Height="14"
                                           Fill="{Binding Swatch}" RadiusX="2" RadiusY="2" />
                                <TextBlock Grid.Column="1" Text="{Binding Number}"
                                           FontWeight="Bold" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <map:MapView x:Name="Map" />
    </DockPanel>
</Window>
